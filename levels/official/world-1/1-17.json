  "cutscene": {
    "theme": "happy-meadows",
    "lines": [
      {
        "speaker": "tom",
        "text": "Allow me to introduce your next foe, kitty cat! Introducing... Tom the Frog!",
        "actors": [
          {
            "character": "koshi",
            "x": 0.28,
            "y": 0.65
          },
          {
            "character": "tom",
            "x": 0.9,
            "y": 0.65
          }
        ]
      },
      {
        "speaker": "tom-frog",
        "text": "Rib-bit! I am Tom the Frog. Ruler of the Happy Meadows. Koshi, prepare to depart the physical world.",
        "actors": [
          {
            "character": "koshi",
            "x": 0.28,
            "y": 0.65
          },
          {
            "character": "tom",
            "x": 0.9,
            "y": 0.65
          },
          {
            "character": "tom-frog",
            "x": 0.58,
            "y": 0.65
          }
        ]
      },
      {
        "speaker": "koshi",
        "text": "Hold on a sec. You're also named Tom? Seriously?",
        "actors": [
          {
            "character": "koshi",
            "x": 0.28,
            "y": 0.65
          },
          {
            "character": "tom",
            "x": 0.9,
            "y": 0.65
          },
          {
            "character": "tom-frog",
            "x": 0.58,
            "y": 0.65
          }
        ]
      },
      {
        "speaker": "tom",
        "text": "Yes. Our AI mother brain is not overly creative. It has derived that Tom is the optimal name under 87.3% of selected metrics via a Monte Carlo simulation which took 5 billion years of CPU time.",
        "actors": [
          {
            "character": "koshi",
            "x": 0.28,
            "y": 0.65
          },
          {
            "character": "tom",
            "x": 0.9,
            "y": 0.65
          },
          {
            "character": "tom-frog",
            "x": 0.58,
            "y": 0.65
          }
        ]
      },
      {
        "speaker": "koshi",
        "text": "I don't know what that means, but thanks for the information.",
        "actors": [
          {
            "character": "koshi",
            "x": 0.28,
            "y": 0.65
          },
          {
            "character": "tom",
            "x": 0.9,
            "y": 0.65
          },
          {
            "character": "tom-frog",
            "x": 0.58,
            "y": 0.65
          }
        ]
      },
      {
        "speaker": "tom",
        "text": "Long story short, little one, is that Tom the Frog will be waiting for you at the final level of this world to show you his true power.",
        "actors": [
          {
            "character": "koshi",
            "x": 0.28,
            "y": 0.65
          },
          {
            "character": "tom",
            "x": 0.9,
            "y": 0.65
          },
          {
            "character": "tom-frog",
            "x": 0.58,
            "y": 0.65
          }
        ]
      },
      {
        "speaker": "tom-frog",
        "text": "Rib-bit! That is, if you make it that far!",
        "actors": [
          {
            "character": "koshi",
            "x": 0.28,
            "y": 0.65
          },
          {
            "character": "tom",
            "x": 0.9,
            "y": 0.65
          },
          {
            "character": "tom-frog",
            "x": 0.58,
            "y": 0.65
          }
        ]
      }
    ]
  },
