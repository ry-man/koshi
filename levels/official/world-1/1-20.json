  "cutscene": {
    "theme": "happy-meadows",
    "lines": [
      {
        "speaker": "tom",
        "text": "You are getting quite far, little one. How have you acquired such power?",
        "actors": [
          {
            "character": "koshi",
            "x": 0.28,
            "y": 0.65
          },
          {
            "character": "tom",
            "x": 0.9,
            "y": 0.65
          },
          {
            "character": "tom-frog",
            "x": 0.58,
            "y": 0.65
          }
        ]
      },
      {
        "speaker": "koshi",
        "text": "I was bit by a radioactive flea when I was a stray kitten. Then before I knew it, I was an expert in hand to paw combat!",
        "actors": [
          {
            "character": "koshi",
            "x": 0.28,
            "y": 0.65
          },
          {
            "character": "tom",
            "x": 0.9,
            "y": 0.65
          },
          {
            "character": "tom-frog",
            "x": 0.58,
            "y": 0.65
          }
        ]
      },
      {
        "speaker": "tom",
        "text": "Ah yes. This is the obvious initial condition. If I had feeling, I would feel embarrassed.",
        "actors": [
          {
            "character": "koshi",
            "x": 0.28,
            "y": 0.65
          },
          {
            "character": "tom",
            "x": 0.9,
            "y": 0.65
          },
          {
            "character": "tom-frog",
            "x": 0.58,
            "y": 0.65
          }
        ]
      },
      {
        "speaker": "tom-frog",
        "text": "Rib-bit! This cat really grinds my gears!",
        "actors": [
          {
            "character": "koshi",
            "x": 0.28,
            "y": 0.65
          },
          {
            "character": "tom",
            "x": 0.9,
            "y": 0.65
          },
          {
            "character": "tom-frog",
            "x": 0.58,
            "y": 0.65
          }
        ]
      }
    ]
  },
