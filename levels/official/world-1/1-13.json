  "cutscene": {
    "theme": "happy-meadows",
    "lines": [
      {
        "speaker": "tom",
        "text": "Well done, kitty, in your elusion of our magical blocks. However, we are just beginning!",
        "actors": [
          {
            "character": "koshi",
            "x": 0.28,
            "y": 0.65
          },
          {
            "character": "tom",
            "x": 0.5,
            "y": 0.65
          }
        ]
      },
      {
        "speaker": "tom",
        "text": "We will surely get you with the forthcoming onslaught of hexagonal obstructions!",
        "actors": [
          {
            "character": "koshi",
            "x": 0.28,
            "y": 0.65
          },
          {
            "character": "tom",
            "x": 0.5,
            "y": 0.65,
            "accessories": [
              "top-hat",
              "magic-wand"
            ]
          }
        ]
      },
      {
        "speaker": "koshi",
        "text": "You do realize I effectively have infinite lives, right buddy?",
        "actors": [
          {
            "character": "koshi",
            "x": 0.28,
            "y": 0.65
          },
          {
            "character": "tom",
            "x": 0.5,
            "y": 0.65,
            "accessories": [
              "top-hat",
              "magic-wand"
            ]
          }
        ]
      },
      {
        "speaker": "tom",
        "text": "Yes. But the developers have made this game sufficiently long that my confidence is not misplaced!",
        "actors": [
          {
            "character": "koshi",
            "x": 0.28,
            "y": 0.65
          },
          {
            "character": "tom",
            "x": 0.5,
            "y": 0.65,
            "accessories": [
              "top-hat",
              "magic-wand"
            ]
          }
        ]
      }
    ]
  },
