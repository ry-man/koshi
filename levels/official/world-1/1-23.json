      "type": "food",
      "amount": 45
    }
  },
  "cutscene": {
    "theme": "happy-meadows",
    "lines": [
      {
        "speaker": "tom-frog",
        "text": "Rib-bit! Why did the kitty cat cross the road, Koshi?",
        "actors": [
          {
            "character": "koshi",
            "x": 0.1,
            "y": 0.65
          },
          {
            "character": "tom-frog",
            "x": 0.42,
            "y": 0.65
          }
        ]
      },
      {
        "speaker": "koshi",
        "text": "To save the world from evil AI robots?",
        "actors": [
          {
            "character": "koshi",
            "x": 0.1,
            "y": 0.65
          },
          {
            "character": "tom-frog",
            "x": 0.42,
            "y": 0.65
          }
        ]
      },
      {
        "speaker": "tom-frog",
        "text": "Incorrect. It was an indoor cat who was accidentally let out, and was lost, looking for home, and almost got hit by a car.",
        "actors": [
          {
            "character": "koshi",
            "x": 0.1,
            "y": 0.65
          },
          {
            "character": "tom-frog",
            "x": 0.42,
            "y": 0.65
          }
        ]
      },
      {
        "speaker": "koshi",
        "text": "Is that supposed to be a joke?",
        "actors": [
          {
            "character": "koshi",
            "x": 0.1,
            "y": 0.65
          },
          {
            "character": "tom-frog",
            "x": 0.42,
            "y": 0.65
          }
        ]
      },
      {
        "speaker": "tom-frog",
        "text": "Correct. I will disarm you through humor, then strike between your chuckles!",
        "actors": [
          {
            "character": "koshi",
            "x": 0.1,
            "y": 0.65
          },
          {
            "character": "tom-frog",
            "x": 0.42,
            "y": 0.65
          }
        ]
      }
    ]
  },
