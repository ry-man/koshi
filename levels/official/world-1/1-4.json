  "levelInfo": {
    "pages": [
      {
        "title": "Cat Block",
        "text": "Every level has a cat block Koshi can collect. Each level may have a different way to find or earn it. Hints are provided at the start of the levels when you still have one to collect.",
        "graphics": [
          "item:cat-block"
        ]
      },
      {
        "title": "Keys & Treasure Chests",
        "text": "Some levels have treasure chests. These chests always hold a cat block, but Koshi must collect a certain number of keys in order to open it. The keys required to open it will be indicated below the chest. Keys can be collected throughout the level. Sometimes enemies will be carrying them - Koshi must destroy them to take the key!",
        "graphics": [
          "item:key",
          "item:treasure-chest"
        ]
      }
    ]
  },
