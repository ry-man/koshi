  "cutscene": {
    "theme": "happy-meadows",
    "lines": [
      {
        "speaker": "tom",
        "text": "You may have proven yourself to not be a total pushover, kitty cat. However, your demise is inevitable.",
        "actors": [
          {
            "character": "koshi",
            "x": 0.28,
            "y": 0.65
          },
          {
            "character": "mouse",
            "x": 0.67,
            "y": 0.65
          },
          {
            "character": "tom",
            "x": 0.5,
            "y": 0.65
          }
        ]
      },
      {
        "speaker": "mouse",
        "text": "I dunno boss. He really wacked us.",
        "actors": [
          {
            "character": "koshi",
            "x": 0.28,
            "y": 0.65
          },
          {
            "character": "mouse",
            "x": 0.67,
            "y": 0.65
          },
          {
            "character": "tom",
            "x": 0.5,
            "y": 0.65
          }
        ]
      },
      {
        "speaker": "tom",
        "text": "Silence!",
        "actors": [
          {
            "character": "koshi",
            "x": 0.28,
            "y": 0.65
          },
          {
            "character": "mouse",
            "x": 0.67,
            "y": 0.65
          },
          {
            "character": "tom",
            "x": 0.5,
            "y": 0.65
          }
        ]
      },
      {
        "speaker": "mouse",
        "text": "Next thing you know it, he's going to find that secret treasure box of ours sitting over there in the corner. Things really aren't looking good!",
        "actors": [
          {
            "character": "koshi",
            "x": 0.28,
            "y": 0.65
          },
          {
            "character": "mouse",
            "x": 0.67,
            "y": 0.65
          },
          {
            "character": "tom",
            "x": 0.5,
            "y": 0.65
          }
        ]
      },
      {
        "speaker": "koshi",
        "text": "Treasure box! Awesome. Count me in!",
        "actors": [
          {
            "character": "koshi",
            "x": 0.28,
            "y": 0.65
          },
          {
            "character": "mouse",
            "x": 0.67,
