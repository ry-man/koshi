          },
          {
            "character": "robo-trash-bin",
            "x": 0.58,
            "y": 0.65,
            "accessories": [
              "item:stopwatch"
            ]
          }
        ]
      },
      {
        "speaker": "tom-frog",
        "text": "Rib-bit! A dead cat you are, Koshi!",
        "actors": [
          {
            "character": "koshi",
            "x": 0.28,
            "y": 0.65
          },
          {
            "character": "tom-frog",
            "x": 0.9,
            "y": 0.65
          },
          {
            "character": "robo-trash-bin",
            "x": 0.58,
            "y": 0.65,
            "accessories": [
              "item:stopwatch"
            ]
          }
        ]
      },
      {
        "speaker": "koshi",
        "text": "Well, I guess I'll just have to take that from you!",
        "actors": [
          {
            "character": "koshi",
            "x": 0.28,
            "y": 0.65,
            "accessories": [
              "weapon:wood"
            ]
          },
          {
            "character": "tom-frog",
            "x": 0.9,
            "y": 0.65
          },
          {
            "character": "robo-trash-bin",
            "x": 0.58,
            "y": 0.65,
            "accessories": [
              "item:stopwatch"
            ]
          }
        ]
      },
      {
        "speaker": "tom-frog",
        "text": "Rib-bit! Run away, trash bin! This cat is crazy!",
        "actors": [
          {
