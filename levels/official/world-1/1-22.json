  "cutscene": {
    "theme": "happy-meadows",
    "lines": [
      {
        "speaker": "robo-trash-bin",
        "text": "Alright, cat! This time we'll hold on to these stopwatches. You'll surely run out of time now!",
        "actors": [
          {
            "character": "koshi",
            "x": 0.28,
            "y": 0.65
          },
          {
            "character": "tom-frog",
            "x": 0.9,
