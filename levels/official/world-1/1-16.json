  "cutscene": {
    "theme": "happy-meadows",
    "lines": [
      {
        "speaker": "tom",
        "text": "Do you know what day today is, little one? Garbage day!",
        "actors": [
          {
            "character": "koshi",
            "x": 0.28,
            "y": 0.65
          },
          {
            "character": "tom",
            "x": 0.9,
            "y": 0.65
          }
        ]
      },
      {
        "speaker": "robo-trash-bin",
        "text": "Reporting for duty, sir! Happy to spread my slop anywhere it is needed!",
        "actors": [
          {
            "character": "koshi",
            "x": 0.28,
            "y": 0.65
          },
          {
            "character": "tom",
            "x": 0.9,
            "y": 0.65
          },
          {
            "character": "robo-trash-bin",
            "x": 0.58,
            "y": 0.65
          }
        ]
      },
      {
        "speaker": "tom",
        "text": "That's right. My trash bins will spill sticky muck all over the place!",
        "actors": [
          {
            "character": "koshi",
            "x": 0.28,
            "y": 0.65
          },
          {
            "character": "tom",
            "x": 0.9,
            "y": 0.65
          },
          {
            "character": "robo-trash-bin",
            "x": 0.58,
            "y": 0.65
          }
        ]
      },
      {
        "speaker": "koshi",
        "text": "No biggie. I've seen some pretty slimy litterboxes in my day. Nothing I can't handle!",
        "actors": [
          {
            "character": "koshi",
            "x": 0.28,
            "y": 0.65
          },
          {
            "character": "tom",
            "x": 0.9,
            "y": 0.65
          },
          {
            "character": "robo-trash-bin",
            "x": 0.58,
            "y": 0.65
          }
        ]
      }
    ]
  },
  "levelInfo": {
    "pages": [
      {
        "title": "Robo Trash Bin",
        "text": "Robo Trash Bins will wander around the arena and periodically dump slime of a random color onto randomly chosen bricks.\n\nIf you don't act fast, they may fill the entire arena with slime!",
        "graphics": [
          "enemy:robo-trash-bin"
