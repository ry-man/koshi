  "cutscene": {
    "theme": "happy-meadows",
    "lines": [
      {
        "speaker": "mouse",
        "text": "We have a new plan to stop you in your tracks, hero cat! We have rendered many bricks useless for your purposes!",
        "actors": [
          {
            "character": "koshi",
            "x": 0.28,
            "y": 0.65
          },
          {
            "character": "mouse",
            "x": 0.67,
            "y": 0.65
          }
        ]
      },
      {
        "speaker": "mouse",
        "text": "We will have you trapped in a corner before you know it!",
        "actors": [
          {
            "character": "koshi",
            "x": 0.28,
            "y": 0.65
          },
          {
            "character": "mouse",
            "x": 0.67,
            "y": 0.65
          }
        ]
      },
      {
        "speaker": "koshi",
        "text": "Darn! I wish I didn't have to stick to random bricks for my movement. Here's to hoping I have enough options!",
        "actors": [
          {
            "character": "koshi",
            "x": 0.28,
            "y": 0.65
          },
          {
            "character": "mouse",
            "x": 0.67,
            "y": 0.65
          }
        ]
      }
    ]
  },
  "levelInfo": {
    "pages": [
      {
        "title": "Cinder Bricks",
        "text": "Cinder bricks cannot be used to direct Koshi's movement at any point. They only serve as spots for Koshi to potentially stop due to his motion directed by other bricks.",
