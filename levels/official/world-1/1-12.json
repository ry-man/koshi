  "cutscene": {
    "theme": "happy-meadows",
    "lines": [
      {
        "speaker": "koshi",
        "text": "Howdy, Tom! How's that taking over the world thing going?",
        "actors": [
          {
            "character": "koshi",
            "x": 0.28,
            "y": 0.65
          },
          {
            "character": "tom",
            "x": 0.5,
            "y": 0.65
          }
        ]
      },
      {
        "speaker": "tom",
        "text": "It will be going much better in a moment, little one! Mwahaha! You may have met your match with my next trap.",
        "actors": [
          {
            "character": "koshi",
            "x": 0.28,
            "y": 0.65
          },
          {
            "character": "tom",
            "x": 0.5,
            "y": 0.65
          },
          {
            "character": "mouse",
            "x": 0.67,
            "y": 0.65
          }
        ]
      },
      {
        "speaker": "mouse",
        "text": "We've been researching magic spells! Now we can make giant blocks appear right on top of you!",
        "actors": [
          {
            "character": "koshi",
            "x": 0.28,
            "y": 0.65
          },
          {
            "character": "tom",
            "x": 0.5,
