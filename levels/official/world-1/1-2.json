  "catBlock": {
    "description": "To earn Cat Brick: Complete the level with at least 20 food points.",
    "messages": {
      "item": "Koshi found the Cat Block!",
      "enemy": "Koshi found a Cat Block carried by an enemy!",
      "chest": "Koshi opened the treasure chest and found the Cat Block!",
      "achievement": "Koshi earned the Cat Brick!"
    },
    "trigger": {
      "type": "food",
      "amount": 20
    }
  },
  "cutscene": {
    "theme": "happy-meadows",
    "lines": [
      {
        "speaker": "koshi",
        "text": "Yum! Thanks for the food, beak breath! I could use some more, if you don't mind!",
        "actors": [
          {
            "character": "koshi",
            "x": 0.28,
            "y": 0.65
          },
          {
            "character": "mouse",
            "x": 0.67,
            "y": 0.65
          },
          {
            "character": "tom",
            "x": 0.5,
            "y": 0.65
          }
        ]
      },
      {
        "speaker": "tom",
        "text": "You wretched feline! Now you will pay. I have summoned a small pack of my Robo Mice to chase you around somewhat aimlessly.",
        "actors": [
          {
            "character": "koshi",
            "x": 0.28,
            "y": 0.65
          },
          {
            "character": "mouse",
            "x": 0.67,
            "y": 0.65
          },
          {
            "character": "tom",
            "x": 0.5,
            "y": 0.65
          }
        ]
      },
      {
        "speaker": "mouse",
        "text": "Hey cat! You can't hurt us with your puny claws, so you better just try and dodge. I sure hope you don't get a weapon in a future level or else we're toast!",
        "actors": [
          {
            "character": "koshi",
            "x": 0.28,
            "y": 0.65
          },
          {
            "character": "mouse",
            "x": 0.67,
            "y": 0.65
          },
          {
            "character": "tom",
            "x": 0.5,
            "y": 0.65
          }
        ]
      },
      {
        "speaker": "koshi",
        "text": "No sweat, robo dummy! I'll enjoy skipping around you while I finish up another snack!",
        "actors": [
          {
            "character": "koshi",
            "x": 0.28,
            "y": 0.65
          },
          {
            "character": "mouse",
            "x": 0.67,
            "y": 0.65
          },
          {
            "character": "tom",
            "x": 0.5,
            "y": 0.65
          }
        ]
      }
    ]
  },
  "levelInfo": {
    "pages": [
      {
        "title": "Robo Mouse",
        "text": "The Robo Mouse will move around randomly and periodically pause. If they contact Koshi, he will lose a heart. If he loses all three hearts, Koshi dies and has to try again!",
        "graphics": [
          "enemy:mouse"
        ]
      },
      {
        "title": "Heart",
        "text": "Hearts will appear at random location on the game board to refill Koshi's missing health. These hearts are triggered by when Koshi eats a certain amount of food (the \"heart cost\") for each level. The amount of food required to eat to generate the next heart is shown underneath Koshi's health meter.",
        "graphics": [
          "heart:heart"
        ]
      }
    ]
  },
