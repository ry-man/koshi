  "cutscene": {
    "theme": "happy-meadows",
    "lines": [
      {
        "speaker": "tom",
        "text": "You must be the hero of legends my systems have been informing me about. Consider this the beginning of the battle for this world!",
        "actors": [
          {
            "character": "koshi",
            "x": 0.28,
            "y": 0.65
          },
          {
            "character": "mouse",
            "x": 0.67,
            "y": 0.65
          },
          {
            "character": "tom",
            "x": 0.5,
            "y": 0.65
          }
        ]
      },
      {
        "speaker": "mouse",
        "text": "Yeah! You're in trouble now mister!",
        "actors": [
          {
            "character": "koshi",
            "x": 0.28,
            "y": 0.65
          },
          {
            "character": "mouse",
            "x": 0.67,
            "y": 0.65
          },
          {
            "character": "tom",
            "x": 0.5,
            "y": 0.65
          }
        ]
      },
      {
        "speaker": "mouse",
        "text": "I've added some obstructions to get in your way for our next battle. Watch out!",
        "actors": [
          {
            "character": "koshi",
            "x": 0.28,
            "y": 0.65
          },
          {
            "character": "mouse",
            "x": 0.67,
            "y": 0.65
          },
          {
            "character": "tom",
            "x": 0.5,
            "y": 0.65
          }
        ]
      },
      {
        "speaker": "koshi",
        "text": "Obstructions? That sounds like a formidable foe! This hero of legends may have met his match!",
        "actors": [
          {
            "character": "koshi",
            "x": 0.28,
            "y": 0.65
          },
          {
            "character": "mouse",
            "x": 0.67,
            "y": 0.65
          },
          {
            "character": "tom",
            "x": 0.5,
            "y": 0.65
          }
        ]
      }
    ]
  },
  "levelInfo": {
    "pages": [
      {
        "title": "Obstructions",
        "text": "Obstructions are objects which get in the way of Koshi's movement and redirect his path. They cannot be targeted like bricks to direct Koshi's movement. Obstructions also block enemies and certain projectiles.",
