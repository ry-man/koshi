  "levelInfo": {
    "pages": [
      {
        "title": "Hammer Weapon",
        "text": "Hammers work similarly to swords but with the added ability to multi-strike enemies with shields.\n\nA hammer will damage shielded enemies by as many points of damage as it can provide. For example, an unused bronze hammer can destroy a green-shielded enemy with one strike (3 damage)!\n\nNote that hammers always use the maximum damage they can provide, and no more.",
        "graphics": [
          "weapon:hammer-bronze",
          "weapon:hammer-silver",
          "weapon:hammer-gold"
        ]
      }
    ]
  },
