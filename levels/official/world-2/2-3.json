  "cutscene": {
    "theme": "catnip-beach",
    "lines": [
      {
        "speaker": "tom",
        "text": "Allow me to introduce the ruler of Catnip Beach. It is none other than...",
        "actors": [
          {
            "character": "koshi",
            "x": 0.28,
            "y": 0.65
          },
          {
            "character": "tom",
            "x": 0.9,
            "y": 0.65
          },
          {
            "character": "boss",
            "x": 0.58,
            "y": 0.65
          }
        ]
      },
      {
        "speaker": "koshi",
        "text": "Tom the Toaster?",
        "actors": [
          {
            "character": "koshi",
            "x": 0.28,
            "y": 0.65
          },
          {
            "character": "tom",
            "x": 0.9,
            "y": 0.65
          },
          {
            "character": "boss",
            "x": 0.58,
            "y": 0.65
          }
        ]
      },
      {
        "speaker": "tom",
        "text": "Have you two met?",
        "actors": [
          {
            "character": "koshi",
            "x": 0.28,
            "y": 0.65
          },
          {
            "character": "tom",
            "x": 0.9,
            "y": 0.65
          },
          {
            "character": "boss",
            "x": 0.58,
            "y": 0.65
          }
        ]
      },
      {
        "speaker": "boss",
        "text": "Negative. I must just look like a Tom. I get that sometimes.",
        "actors": [
          {
            "character": "koshi",
            "x": 0.28,
            "y": 0.65
          },
          {
            "character": "tom",
            "x": 0.9,
            "y": 0.65
          },
          {
            "character": "boss",
            "x": 0.58,
            "y": 0.65
          }
        ]
      },
      {
        "speaker": "boss",
        "text": "Anyways, Koshi. You are toast this time! For your sake, I hope you don't make it to level 25 of this world!",
        "actors": [
          {
            "character": "koshi",
            "x": 0.28,
            "y": 0.65
          },
          {
            "character": "tom",
            "x": 0.9,
            "y": 0.65
          },
          {
            "character": "boss",
            "x": 0.58,
            "y": 0.65
          }
        ]
      },
      {
        "speaker": "koshi",
        "text": "I'll see you there, you brave little toaster!",
        "actors": [
          {
            "character": "koshi",
            "x": 0.28,
            "y": 0.65
          },
          {
            "character": "tom",
            "x": 0.9,
            "y": 0.65
          },
          {
            "character": "boss",
            "x": 0.58,
            "y": 0.65
          }
        ]
      }
    ]
  },
  "levelInfo": {
    "pages": [
      {
        "title": "Batteries",
        "text": "Spawning bricks which have already been used can be recharged if Koshi has a battery. Every battery Koshi collects allows him to recharge a spawning brick one time!\n\nKoshi can hold multiple batteries at once and their count is indicated at the top of the screen.\n\nWhen Koshi is holding any batteries, a lightning bolt will swirl around him to let you know!",
        "graphics": [
          "item:battery"
        ]
      }
    ]
  },
