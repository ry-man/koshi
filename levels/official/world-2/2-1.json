  "cutscene": {
    "theme": "catnip-beach",
    "lines": [
      {
        "speaker": "tom",
        "text": "Welcome to Catnip Beach, little one! Don't get too cozy, as there are new enemies and traps headed you way!",
        "actors": [
          {
            "character": "koshi",
            "x": 0.28,
            "y": 0.65
          },
          {
            "character": "tom",
            "x": 0.9,
            "y": 0.65
          }
        ]
      },
      {
        "speaker": "tom",
        "text": "Exhibit A: Robo Crabs! These fearsome monsters litter our beach and will make your stay most unenjoyable!",
        "actors": [
          {
            "character": "koshi",
            "x": 0.28,
            "y": 0.65
          },
          {
            "character": "tom",
            "x": 0.9,
            "y": 0.65
          },
          {
            "character": "robo-crab",
            "x": 0.58,
            "y": 0.65
          }
        ]
      },
      {
        "speaker": "robo-crab",
        "text": "Afternoon, Koshi. Pleased to meet you. I mostly just walk around. But if you run into me you might die!",
        "actors": [
          {
            "character": "koshi",
            "x": 0.28,
            "y": 0.65
          },
          {
            "character": "tom",
            "x": 0.9,
            "y": 0.65
          },
          {
            "character": "robo-crab",
            "x": 0.58,
            "y": 0.65
          }
        ]
      },
      {
        "speaker": "koshi",
        "text": "Seems like a nice enough evil robot to me, Tom!",
        "actors": [
          {
            "character": "koshi",
            "x": 0.28,
            "y": 0.65
          },
          {
            "character": "tom",
            "x": 0.9,
            "y": 0.65
          },
          {
            "character": "robo-crab",
            "x": 0.58,
            "y": 0.65
          }
        ]
      }
    ]
  },
  "levelInfo": {
    "pages": [
      {
        "title": "Robo Crabs",
        "text": "Robo Crabs only move either vertically or horizontally, but they do change their speed. Watch their eyes as it will telegraph when they are about to speed up!",
        "graphics": [
          "enemy:robo-crab"
        ]
      }
