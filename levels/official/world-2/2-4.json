  "cutscene": {
    "theme": "catnip-beach",
    "lines": [
      {
        "speaker": "boss",
        "text": "I am lack-toast intolerant. I must have my toast. And it's dangerous toast that I can shoot at your face to kill you!",
        "actors": [
          {
            "character": "koshi",
            "x": 0.28,
            "y": 0.65
          },
          {
            "character": "robo-crab",
            "x": 0.9,
            "y": 0.65,
            "accessories": [
              "item:key"
            ]
          },
          {
            "character": "boss",
            "x": 0.58,
            "y": 0.65
          }
        ]
      },
      {
        "speaker": "koshi",
        "text": "That's both funny and scary.",
        "actors": [
          {
            "character": "koshi",
            "x": 0.28,
            "y": 0.65
          },
          {
            "character": "robo-crab",
            "x": 0.9,
            "y": 0.65,
            "accessories": [
              "item:key"
            ]
          },
          {
            "character": "boss",
            "x": 0.58,
            "y": 0.65
          }
        ]
      },
      {
        "speaker": "robo-crab",
        "text": "Jolly good chap, you won't have to worry about fighting Tom as we've hidden him behind several locked doors and are hiding the keys.",
        "actors": [
          {
            "character": "koshi",
            "x": 0.28,
            "y": 0.65
          },
          {
            "character": "robo-crab",
            "x": 0.9,
            "y": 0.65,
            "accessories": [
              "item:key"
            ]
          },
          {
            "character": "boss",
            "x": 0.58,
            "y": 0.65
          }
        ]
      },
      {
        "speaker": "koshi",
        "text": "Appreciate the concern, crabby, but I think it's my destiny!",
        "actors": [
          {
            "character": "koshi",
            "x": 0.28,
            "y": 0.65
          },
          {
            "character": "robo-crab",
            "x": 0.9,
            "y": 0.65,
            "accessories": [
              "item:key"
            ]
          },
          {
            "character": "boss",
            "x": 0.58,
            "y": 0.65
          }
        ]
      }
    ]
